rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'harmandeepsingh7814@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validations ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['role']) &&
             data.keys().size() <= 15 &&
             data.role in ['student', 'instructor', 'admin'] &&
             (data.get('email', '') is string) &&
             (data.get('displayName', '') is string) &&
             (data.get('studentId', '') is string) &&
             (data.get('phoneNumber', '') is string) &&
             (data.get('academicYear', '') is string) &&
             (data.get('bio', '') is string);
    }

    function isValidResource(data) {
      return data.keys().hasAll(['title', 'subject', 'type', 'authorId', 'authorName', 'createdAt']) &&
             data.keys().size() <= 15 &&
             data.title is string && data.title.size() <= 200 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.type in ['Class Notes', 'PYQ', 'Assignment'] &&
             data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.createdAt == request.time &&
             (data.get('description', '') is string) &&
             (data.get('academicYear', '') is string) &&
             (data.get('verified', false) is bool);
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'content', 'createdAt']) &&
             data.keys().size() <= 15 &&
             data.authorId == request.auth.uid &&
             data.content is string && data.content.size() <= 5000 &&
             data.createdAt == request.time;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['channelId', 'userId', 'content', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.userId == request.auth.uid &&
             data.content is string && data.content.size() <= 2000 &&
             data.createdAt == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if true; 
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && 
                    isValidUser(incoming()) && 
                    (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'studentId', 'phoneNumber', 'academicYear', 'bio', 'updatedAt']));
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidResource(incoming());
      allow update: if (isOwner(existing().authorId) || isAdmin()) &&
                    isValidResource(incoming()) &&
                    incoming().authorId == existing().authorId &&
                    incoming().createdAt == existing().createdAt &&
                    (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'subject', 'academicYear', 'type']));
      allow delete: if isOwner(existing().authorId) || isAdmin();
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                    isEmailVerified() && 
                    isValidPost(incoming()) &&
                    incoming().likesCount == 0 &&
                    incoming().commentsCount == 0;
      allow update: if (isOwner(existing().authorId) || isAdmin()) && 
                    isValidPost(incoming()) && 
                    incoming().authorId == existing().authorId &&
                    incoming().createdAt == existing().createdAt &&
                    (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['content', 'imageUrl', 'tags']));
      allow delete: if isOwner(existing().authorId) || isAdmin();
    }

    match /channels/{channelId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isEmailVerified() && isValidChatMessage(incoming());
      allow update: if (isOwner(existing().userId) || isAdmin()) &&
                    isValidChatMessage(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['content']));
      allow delete: if isOwner(existing().userId) || isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isAdmin();
    }
  }
}
