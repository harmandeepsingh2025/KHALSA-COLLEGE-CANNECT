{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private user data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "instructor", "admin"] },
        "studentId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "academicYear": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role"]
    },
    "Resource": {
      "title": "Academic Resource",
      "description": "Shared academic files and notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "subject": { "type": "string" },
        "academicYear": { "type": "string" },
        "type": { "type": "string", "enum": ["Class Notes", "PYQ", "Assignment"] },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subject", "type", "authorId", "authorName", "createdAt"]
    },
    "Post": {
      "title": "Community Post",
      "description": "Academic feed post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorRole": { "type": "string" },
        "content": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "imageUrl": { "type": "string" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "content", "createdAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Message in an academic channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "userRole": { "type": "string" },
        "content": { "type": "string" },
        "isInstructor": { "type": "boolean" },
        "attachment": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId", "userId", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Main community feed posts"
    },
    "/channels/{channelId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages within dedicated academic channels"
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Shared academic study materials"
    }
  }
}
